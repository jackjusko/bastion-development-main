# Express API
PORT=8010
PUBLIC_URL=http://localhost:8010
CORS_ORIGIN=http://localhost:3000

# sqlite (default) or mysql
DATABASE_DRIVER=sqlite
SQLITE_PATH=./api/data/bastionfit.db

# MySQL is optional; used only when DATABASE_DRIVER=mysql
MYSQL_HOST=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# Stripe Connect. Leave empty for local development without live charges.
STRIPE_SECRET_KEY=

# AWS SES + S3. Leave empty to skip sending mail and uploading images.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2
AWS_S3_BUCKET=bastionuploadedresources

# Next.js client
NEXT_PUBLIC_API_URL=http://localhost:8010
