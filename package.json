  "description": "Bastion peer-to-peer personal training marketplace",
  "workspaces": [
    "api",
    "frontend-next"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=api",
    "dev:api": "npm run dev --workspace=api",
